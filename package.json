{
	"name": "@alessiofrittoli/date-utils",
	"version": "4.1.0",
	"description": "Lightweight TypeScript date utility functions library",
	"type": "module",
	"author": {
		"name": "Alessio Frittoli",
		"email": "info@alessiofrittoli.it",
		"url": "https://alessiofrittoli.it"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/alessiofrittoli"
		}
	],
	"keywords": [
		"dates",
		"timezones",
		"datetime",
		"local-datetime"
	],
	"homepage": "https://github.com/alessiofrittoli/date-utils#readme",
	"bugs": {
		"url": "https://github.com/alessiofrittoli/date-utils/issues",
		"email": "info@alessiofrittoli.it"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alessiofrittoli/date-utils.git"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./format": {
			"import": {
				"types": "./dist/format/index.d.mts",
				"default": "./dist/format/index.mjs"
			},
			"require": {
				"types": "./dist/format/index.d.ts",
				"default": "./dist/format/index.js"
			}
		},
		"./timezones": {
			"import": {
				"types": "./dist/timezones/index.d.mts",
				"default": "./dist/timezones/index.mjs"
			},
			"require": {
				"types": "./dist/timezones/index.d.ts",
				"default": "./dist/timezones/index.js"
			}
		},
		"./timezones/identifiers": {
			"import": {
				"types": "./dist/timezones/identifiers.d.mts",
				"default": "./dist/timezones/identifiers.mjs"
			},
			"require": {
				"types": "./dist/timezones/identifiers.d.ts",
				"default": "./dist/timezones/identifiers.js"
			}
		},
		"./timezones/types": {
			"import": {
				"types": "./dist/timezones/types.d.mts",
				"default": "./dist/timezones/types.mjs"
			},
			"require": {
				"types": "./dist/timezones/types.d.ts",
				"default": "./dist/timezones/types.js"
			}
		},
		"./common": {
			"import": {
				"types": "./dist/common.d.mts",
				"default": "./dist/common.mjs"
			},
			"require": {
				"types": "./dist/common.d.ts",
				"default": "./dist/common.js"
			}
		},
		"./utils": {
			"import": {
				"types": "./dist/utils.d.mts",
				"default": "./dist/utils.mjs"
			},
			"require": {
				"types": "./dist/utils.d.ts",
				"default": "./dist/utils.js"
			}
		}
	},
	"sideEffects": false,
	"scripts": {
		"//1a": "*********************************************************************",
		"//1b": "******************** DEV - BUILD - LINT - RELEASE *******************",
		"//1c": "*********************************************************************",
		"dev": "tsdown --watch",
		"build": "pnpm lint && pnpm tsc && pnpm tsdown",
		"lint": "oxlint --report-unused-disable-directives --max-warnings 0",
		"release": "node scripts/release.ts --verbose --npm",
		"//2a": "*********************************************************************",
		"//2b": "***************************** UNIT TESTS ****************************",
		"//2c": "*********************************************************************",
		"test": "vitest --reporter=tree",
		"test:watch": "pnpm test watch",
		"test:ci": "pnpm test run",
		"//3a": "*********************************************************************",
		"//3b": "************************ UNIT TESTS COVERAGE ************************",
		"//3c": "*********************************************************************",
		"test:coverage": "pnpm test:watch --coverage",
		"test:coverage:ci": "pnpm test:ci --coverage",
		"test:serve-coverage": "http-server ./coverage --gzip true -p 0 -o /index.html --silent",
		"test:coverage:serve": "concurrently --prefix none --kill-others \"pnpm test:coverage\" \"pnpm test:serve-coverage\""
	},
	"peerDependencies": {
		"@alessiofrittoli/math-utils": "^2.1.0",
		"@alessiofrittoli/type-utils": "^2.0.0"
	},
	"devDependencies": {
		"@alessiofrittoli/math-utils": "^2.1.0",
		"@alessiofrittoli/node-scripts": "^4.1.0",
		"@alessiofrittoli/package-configs": "^1.6.0",
		"@alessiofrittoli/type-utils": "^2.0.0",
		"@types/node": "^24.19.1",
		"@vitest/coverage-v8": "^5.0.4",
		"concurrently": "^10.0.6",
		"http-server": "^14.1.1",
		"oxlint": "^1.88.0",
		"prettier": "^3.9.10",
		"prettier-plugin-sort-imports": "^1.8.11",
		"tsdown": "^0.23.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	}
}
